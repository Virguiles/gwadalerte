# Toutes ces variables sont FACULTATIVES.
#
# Sans aucune d'entre elles, l'application démarre et fonctionne : la qualité
# de l'air (Gwad'Air), la météo (Open-Meteo) et les tours d'eau (Orisk) sont
# des sources publiques et non authentifiées. Seule la vigilance Météo-France
# est dégradée : la route `/api/vigilance` retombe alors sur le niveau 1 (vert).

# --- Vigilance Météo-France (OAuth2) -----------------------------------------
# Compte gratuit sur https://portail-api.meteofrance.fr/
# Souscrire à l'API « Données Vigilance Outre-Mer » (DPVigilance).
METEOFRANCE_CLIENT_ID=
METEOFRANCE_CLIENT_SECRET=
METEOFRANCE_TOKEN_URL=https://portail-api.meteofrance.fr/token

# --- Cache partagé (Vercel KV / Upstash Redis) -------------------------------
# Absentes, le cache retombe sur une Map en mémoire, suffisante en local.
# Sur Vercel, l'intégration KV renseigne ces deux variables automatiquement.
KV_REST_API_URL=
KV_REST_API_TOKEN=
